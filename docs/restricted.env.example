# aipipe 全局受限密钥模板（通用）
#
# 部署时复制为 data/secrets/restricted.env 并填入真实值：
#   cp docs/restricted.env.example data/secrets/restricted.env
#
# restricted.env 是所有流水线共用的受限 Key 仓库（专用受限 Key，额度受限）。
# 每条流水线只会被注入其 pipeline.yaml 中 env: 声明列出的变量（见 server/executor.py read_secrets）。
# 新增流水线需要新 Key 时，请同步在本文件补一行，并保持变量名与流水线 env: 声明一致。
#
# ---- 翻译/LLM 端点（youtube-dub 等流水线使用，OpenAI 兼容接口）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选：翻译用模型名
# TRANSLATE_MODEL=deepseek-chat
