# 复制为 data/secrets/restricted.env 并填入受限 Key（额度上限）。
# 仅 pipeline.yaml 的 env: 声明会被注入容器。

# 翻译用 LLM 端点（OpenAI 兼容，如 DeepSeek/OpenAI）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选：翻译用的模型名
# TRANSLATE_MODEL=deepseek-chat

# TTS 服务（arktts 网关 /audio/speech：model + input + reference_audio_base64 +
# reference_text；参考音频由流水线从原声 vocals 按 cue 切片，无需手填）
TTS_BASE_URL=http://127.0.0.1:8000/v1
# 本地服务可不填 key（留空则脚本用占位符）
# TTS_API_KEY=
# TTS_MODEL=arktts
